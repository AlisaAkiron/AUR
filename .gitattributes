# Normalize line endings; makepkg and bash choke on CRLF
* text=auto eol=lf

PKGBUILD   text eol=lf linguist-language=Shell
.SRCINFO   text eol=lf linguist-generated=true
*.install  text eol=lf linguist-language=Shell
*.sh       text eol=lf
*.patch    text eol=lf -whitespace
*.diff     text eol=lf -whitespace
*.desktop  text eol=lf

*.png      binary
*.svg      text eol=lf

# Generated by scripts/gen-package-list.sh
PACKAGES.md linguist-generated=true

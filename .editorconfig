# https://editorconfig.org — also read by shfmt
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{PKGBUILD,*.install,*.sh}]
indent_style = space
indent_size = 2
# shfmt options
switch_case_indent = true
space_redirects = false

[Makefile]
indent_style = tab

# Generated by `makepkg --printsrcinfo`; uses tabs
[.SRCINFO]
indent_style = tab

[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
